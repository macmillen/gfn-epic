---
import { Image } from "astro:assets";
import { DateTime } from "luxon";
import type { Card } from "../types";
import { getSafeGameId } from "../utils/data";

export interface Props {
  data: Card[];
}

const { data } = Astro.props;
---

<div class="flex flex-col max-w-5xl mx-auto px-2 items-start">
  <table
    class="game-table divide-y divide-gray-200 space-y-4 border-separate border-spacing-y-4 w-full"
  >
    <thead>
      <tr>
        <th></th>
        <th class="px-2 text-left">
          <span class="pr-3">Release</span>
        </th>
        <th class="px-2 text-left">
          <span class="sm:pr-5">Title</span>
        </th>
        <th class="px-2">
          <span class="sm:pr-5">Info</span>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        data.map(
          ({
            fromDate: _fromDate,
            untilDate: _untilDate,
            title,
            gfnUrl,
            mysteryGame,
            data: { id, cover, rating, websites = [], genres } = {},
          }) => {
            const fromDate = DateTime.fromISO(_fromDate);
            const fromDateStr = fromDate.toLocaleString(DateTime.DATE_MED);
            const untilDate = DateTime.fromISO(_untilDate);
            const untilDateStr = untilDate.toLocaleString(DateTime.DATE_MED);
            const epicWebsite = websites.find((v) =>
              v.url.includes("epicgames.com")
            );
            return (
              <tr
                class="row group"
                data-fromdate={_fromDate}
                data-untildate={_untilDate}
                data-gameid={id}
                id={getSafeGameId(title, _fromDate)}
              >
                <td class="td-cover">
                  <div
                    class={`cover-box ${mysteryGame ? "animate-pulse" : ""}`}
                  >
                    {cover ? (
                      <Image
                        alt=""
                        src={cover}
                        width={72}
                        height={96}
                        class="block"
                      />
                    ) : (
                      <div class="cover-fallback">
                        <svg class="w-12 h-12 text-zinc-500 -rotate-6 scale-125 sm:scale-[2]" aria-hidden="true">
                          <use href="#icon-gamepad" />
                        </svg>
                      </div>
                    )}
                  </div>
                </td>

                <td class="td-date">
                  <div>{fromDateStr}</div>
                  {fromDateStr !== untilDateStr && `- ${untilDateStr}`}
                  <div class="countdown text-red-500" />
                </td>

                <td class="td-title">
                  <span class="title-text">
                    {title}
                  </span>
                  {genres?.length && (
                    <div class="genre-list">
                      {genres.slice(0, 2).map((genre) => (
                        <div class="genre-tag">
                          {genre}
                        </div>
                      ))}
                    </div>
                  )}
                </td>

                <td class="td-info">
                  <div class="info-wrapper">
                    <div class="flex justify-center">
                      <span
                        class={`rating ${
                          rating ? "rating-active" : "rating-inactive"
                        }`}
                      >
                        {rating != null ? Math.round(rating) : "-"}
                      </span>
                    </div>

                    {epicWebsite?.url ? (
                      <a href={epicWebsite.url} target="_blank" rel="noopener noreferrer" class="icon-link">
                        <svg class="icon-action"><use href="#icon-epic-games" /></svg>
                      </a>
                    ) : (
                      <svg class="icon-action text-zinc-500"><use href="#icon-epic-games" /></svg>
                    )}

                    {gfnUrl ? (
                      <a href={gfnUrl} target="_blank" rel="noopener noreferrer" class="icon-link text-green-500">
                        <svg class="icon-action"><use href="#icon-nvidia" /></svg>
                      </a>
                    ) : (
                      <svg class="icon-action text-zinc-500"><use href="#icon-nvidia" /></svg>
                    )}
                  </div>
                </td>
              </tr>
            );
          }
        )
      }
    </tbody>
  </table>
</div>

<style>
  @reference "../styles/global.css";

  .game-table td {
    @apply overflow-hidden px-2 text-sm sm:text-base;
  }
  .td-cover {
    @apply !p-0 w-0 rounded-l-xl;
  }
  .cover-box {
    @apply w-[45px] h-[60px] sm:w-[72px] sm:h-[96px];
  }
  .cover-fallback {
    @apply w-full h-full bg-zinc-600/40 flex items-center justify-center;
  }
  .td-date {
    @apply text-zinc-300 whitespace-nowrap w-0 text-xs sm:text-base pl-5;
  }
  .td-title {
    @apply w-full text-xs sm:text-base;
  }
  .title-text {
    @apply transition duration-300 sm:ml-5 group-hover:text-green-400;
  }
  .genre-list {
    @apply hidden sm:inline-flex gap-2 ml-4 items-center whitespace-nowrap w-0;
  }
  .genre-tag {
    @apply bg-zinc-800 rounded-full py-1 px-2 text-xs;
  }
  .td-info {
    @apply w-0 rounded-r-lg sm:rounded-r-xl;
  }
  .info-wrapper {
    @apply flex justify-end gap-2 items-center sm:mr-5;
  }
  .rating {
    @apply rounded-full w-5 h-5 sm:w-6 sm:h-6 flex justify-center items-center text-xs;
  }
  .rating-active {
    @apply bg-green-500 text-zinc-800;
  }
  .rating-inactive {
    @apply bg-zinc-500;
  }
  .icon-action {
    @apply w-5 h-5 sm:w-6 sm:h-6 shrink-0;
  }
  .icon-link {
    @apply hover:brightness-110;
  }

  .free-now {
    @apply !bg-green-500/10;
  }
  .free-soon {
    @apply !bg-blue-500/5;
  }
  .row {
    @apply font-bold hover:brightness-125 hover:ring-0 bg-gradient-to-r bg-zinc-700/50;
  }
</style>
